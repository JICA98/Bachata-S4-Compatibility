{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bachata S4 game metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cusaId",
    "title",
    "region",
    "publisher",
    "issueNumber"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cusaId": {
      "type": "string",
      "pattern": "^CUSA[0-9]{5}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "issueNumber": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "legacyImported": {
      "type": "boolean"
    }
  }
}
