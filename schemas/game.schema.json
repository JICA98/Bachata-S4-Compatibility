{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bachata S4 game metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cusaId",
    "title",
    "region",
    "publisher",
    "canonicalIssue",
    "legacyIssues"
  ],
  "$defs": {
    "issueReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "number"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "cusaId": {
      "type": "string",
      "pattern": "^CUSA[0-9]{5}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "canonicalIssue": {
      "$ref": "#/$defs/issueReference"
    },
    "legacyIssues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/issueReference"
      }
    },
    "legacyImported": {
      "type": "boolean"
    }
  }
}
